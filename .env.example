# Fichier .env pour les paramètres de connexion Azure SQL Database
# Copiez ce fichier vers .env et remplissez vos propres valeurs
# IMPORTANT: N'ajoutez jamais le fichier .env au contrôle de version (Git)

# Option 1: Chaîne de connexion complète
#AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:incidentsappssqlsrv.database.windows.net,1433;Database=gesincidentsdb;Uid=admindbuser;Pwd=azuredev1234!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Option 2: Paramètres séparés (alternative à la chaîne complète)
#AZURE_SQL_SERVER=tcp:incidentsappssqlsrv.database.windows.net,1433
#AZURE_SQL_USERNAME=admindbuser
#AZURE_SQL_PASSWORD=azuredev1234!

#production
#AZURE_SQL_DATABASE=gesincidentsdb

#production
#AZURE_SQL_DATABASE=appdbstaging

# Exemples de valeurs pour Azure SQL Database:
# AZURE_SQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=monserveur.database.windows.net;DATABASE=incidents_db;UID=admin_user;PWD=MotDePasse123!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Configuration pour Azure Blob Storage avec Service Principal
# Service Principal credentials - obtenus lors de la création du service principal
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Azure Storage Account configuration
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=incidents-data

# Note: Le fichier incidents.csv doit être présent dans le container Azure Blob Storage
# Structure attendue du fichier incidents.csv:
# id,titre,description,gravite,date,statut
# 1,Perte de signal Wi-Fi,Intermittence sur le réseau Wi-Fi dans la zone A,Majeur,2025-09-18,Nouveau
# 2,Serveur de base de données lent,Lenteur observée sur les requêtes de base de données,Critique,2025-09-19,En cours

# Exemple de configuration Blob Storage:
# AZURE_CLIENT_ID=12345678-1234-5678-9012-123456789abc
# AZURE_CLIENT_SECRET=your-secret-value
# AZURE_TENANT_ID=87654321-4321-8765-2109-987654321cba
# AZURE_STORAGE_ACCOUNT_NAME=mystorageaccount
# AZURE_STORAGE_CONTAINER_NAME=incidents-data