# Fichier .env pour les paramètres de connexion Azure SQL Database
# Copiez ce fichier vers .env et remplissez vos propres valeurs
# IMPORTANT: N'ajoutez jamais le fichier .env au contrôle de version (Git)

# Option 1: Chaîne de connexion complète
#AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:incidentsappssqlsrv.database.windows.net,1433;Database=gesincidentsdb;Uid=admindbuser;Pwd=azuredev1234!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Option 2: Paramètres séparés (alternative à la chaîne complète)
#AZURE_SQL_SERVER=tcp:incidentsappssqlsrv.database.windows.net,1433
#AZURE_SQL_USERNAME=admindbuser
#AZURE_SQL_PASSWORD=azuredev1234!

#production
#AZURE_SQL_DATABASE=gesincidentsdb

#production
#AZURE_SQL_DATABASE=appdbstaging

# Exemples de valeurs pour Azure SQL Database:
# AZURE_SQL_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=monserveur.database.windows.net;DATABASE=incidents_db;UID=admin_user;PWD=MotDePasse123!;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"